# Cofer One IA - local configuration
# Copy to .env. Never commit .env.

# Stable client-facing facade. Plain `ollama` and `ollama launch` use this.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=11434

# Physical Ollama stays on a separate host port. Do NOT persist this as the
# user's global OLLAMA_HOST; use `collama` when direct physical access is needed.
OLLAMA_BACKEND_URL=http://host.docker.internal:11435
COFER_PHYSICAL_OLLAMA_HOST=http://127.0.0.1:11435

# LiteLLM gateway + Admin UI
LITELLM_PORT=4000
LITELLM_MASTER_KEY=CHANGE_ME_BOOTSTRAP_WILL_GENERATE
LITELLM_SALT_KEY=CHANGE_ME_BOOTSTRAP_WILL_GENERATE
LITELLM_DB_PASSWORD=CHANGE_ME_BOOTSTRAP_WILL_GENERATE
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=CHANGE_ME_BOOTSTRAP_WILL_GENERATE
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.93.0
POSTGRES_IMAGE=postgres:16

# Optional ChatGPT subscription provider in LiteLLM.
# Authenticate with scripts/auth-chatgpt.*. Then expose one or more logical
# models as comma-separated values. `logical=physical` creates an alias; a
# single value uses the same logical and physical model name.
# Example only (model availability changes over time):
# CHATGPT_MODELS=my-codex=gpt-X-codex,my-general=gpt-X
CHATGPT_MODELS=

# Optional OpenRouter provider.
OPENROUTER_API_KEY=

# Headroom - common optimization layer used by the universal gateway.
HEADROOM_IMAGE=ghcr.io/headroomlabs-ai/headroom:0.32.0
HEADROOM_TELEMETRY=off
HEADROOM_OUTPUT_SHAPER=0
HEADROOM_SAVINGS_PROFILE=coding
HEADROOM_GATEWAY_PORT=8790

# Optional direct Codex -> Headroom -> ChatGPT route. This intentionally skips
# the universal gateway and LiteLLM and uses Codex's own ChatGPT OAuth token.
HEADROOM_CODEX_PORT=8787
CODEX_CHATGPT_BASE_URL=https://chatgpt.com/backend-api/codex

# Internal universal gateway upstream. The headroom-cline alias is kept on the
# Docker network for migration compatibility with v0.1.x .env files.
GATEWAY_UPSTREAM_URL=http://headroom-gateway:8787

# Gateway behavior
GATEWAY_REQUEST_TIMEOUT_SECONDS=600
GATEWAY_MODEL_REFRESH_SECONDS=15
GATEWAY_DEFAULT_CONTEXT_LENGTH=32768
