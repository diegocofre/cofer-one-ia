# Cofer One IA - local configuration
# Copy to .env. Never commit .env.

# Public facade. Cline should point its Ollama provider here.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=11434

# Physical Ollama on the host.
# The normal Ollama CLI uses 127.0.0.1:11435.
# Cofer One IA starts its managed server with 0.0.0.0:11435 so Docker can reach it.
OLLAMA_HOST=127.0.0.1:11435
OLLAMA_BACKEND_URL=http://host.docker.internal:11435

# LiteLLM - pin runtime versions intentionally.
LITELLM_PORT=4000
LITELLM_MASTER_KEY=CHANGE_ME_BOOTSTRAP_WILL_GENERATE
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.93.0

# Headroom - keep this aligned with upstreams.lock.json.
# nonroot matches the persisted /home/nonroot/.headroom volume layout.
HEADROOM_IMAGE=ghcr.io/chopratejas/headroom@sha256:50b85d8e320cfcdf1b38919bb7ae067b93ff7a8de0a93f05b2c1246370200d1c
HEADROOM_TELEMETRY=off
HEADROOM_OUTPUT_SHAPER=0

# Coding is intentionally cache-oriented. It preserves prefix-cache stability
# for long-running coding-agent sessions.
HEADROOM_SAVINGS_PROFILE=balanced

HEADROOM_CLINE_PORT=8790
HEADROOM_CODEX_PORT=8787
HEADROOM_OPENCODE_PORT=8788
HEADROOM_ZCODE_PORT=8789
HEADROOM_CONTINUE_PORT=8791

# OpenRouter is optional. When blank, aliases requiring it are omitted.
OPENROUTER_API_KEY=

# Gateway internal upstream. Keep Headroom in the normal path; override only for diagnostics.
GATEWAY_UPSTREAM_URL=http://headroom-cline:8790

# Gateway behavior
GATEWAY_REQUEST_TIMEOUT_SECONDS=600
GATEWAY_MODEL_REFRESH_SECONDS=15
GATEWAY_DEFAULT_CONTEXT_LENGTH=32768
