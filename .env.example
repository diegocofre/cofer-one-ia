# Cofer One IA - local configuration
# Copy to .env. Never commit .env.

# Stable client-facing facade. Plain `ollama` and `ollama launch` use this.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=11434

# Physical Ollama stays on a separate host port. Do NOT persist this as the
# user's global OLLAMA_HOST; use `collama` when direct physical access is needed.
OLLAMA_BACKEND_URL=http://host.docker.internal:11435
# Native OpenAI-compatible endpoint used by LiteLLM for /v1/responses.
OLLAMA_OPENAI_BASE_URL=http://host.docker.internal:11435/v1
COFER_PHYSICAL_OLLAMA_HOST=http://127.0.0.1:11435

# LiteLLM gateway
LITELLM_PORT=4000
LITELLM_CHATGPT_PORT=4001
LITELLM_MASTER_KEY=CHANGE_ME_BOOTSTRAP_WILL_GENERATE
LITELLM_SALT_KEY=CHANGE_ME_BOOTSTRAP_WILL_GENERATE
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.93.0

# Optional EXTERNAL PostgreSQL. Leave LITELLM_DATABASE_URL empty to run
# Cofer One IA without database-backed LiteLLM features. In that mode the
# universal proxy/routing remains active, while Admin UI/model storage/keys/
# budgets/spend-management features that need PostgreSQL are disabled.
# Prefer scripts/postgres-onboard.* instead of editing the URL by hand.
LITELLM_STORE_MODEL_IN_DB=False
LITELLM_DISABLE_ADMIN_UI=True
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=
# Short-lived client image used only by postgres-onboard verify; no DB server
# is started locally by Cofer One IA.
POSTGRES_CLIENT_IMAGE=postgres:16-alpine

# Optional ChatGPT subscription provider in LiteLLM.
# Authenticate with scripts/auth-chatgpt.*. The fixed OpenAI catalog is
# version-controlled in config/models.json; no model IDs belong in .env.

# Optional OpenRouter provider.
OPENROUTER_API_KEY=
# OpenRouter's OpenAI-compatible API base. Keep the default unless using a
# compatible relay/proxy. Codex uses its native /responses endpoint.
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Optional Cofer U Pass restricted web-model provider.
# Map logical model names to exact Cofer U Pass profile IDs.
# Example: COFER_U_PASS_MODELS=cupass-chatgpt=chatgpt-main
# These models support text/files/bundles but intentionally do NOT support tools.
COFER_U_PASS_MODELS=
COFER_U_PASS_BRIDGE_KEY=CHANGE_ME_BOOTSTRAP_WILL_GENERATE
COFER_U_PASS_BRIDGE_PORT=4011
COFER_U_PASS_REQUEST_TIMEOUT_SECONDS=1800
COFER_U_PASS_WORKER_POLL_SECONDS=25
COFER_U_PASS_WORKER_STALE_SECONDS=90
COFER_U_PASS_MAX_FILE_BYTES=524288000

# Headroom - common optimization layer used by the universal gateway.
HEADROOM_IMAGE=ghcr.io/headroomlabs-ai/headroom:0.32.0
HEADROOM_TELEMETRY=off
HEADROOM_OUTPUT_SHAPER=0
HEADROOM_SAVINGS_PROFILE=coding
HEADROOM_GATEWAY_PORT=8790

# Optional direct Codex -> Headroom -> ChatGPT route. This intentionally skips
# the universal gateway and LiteLLM and uses Codex's own ChatGPT OAuth token.
HEADROOM_CODEX_PORT=8787
CODEX_CHATGPT_BASE_URL=https://chatgpt.com/backend-api/codex

# Internal universal gateway upstream. The headroom-cline alias is kept on the
# Docker network for migration compatibility with v0.1.x .env files.
# ChatGPT subscription aliases bypass Headroom and route directly to the
# dedicated LiteLLM OAuth sidecar.
GATEWAY_UPSTREAM_URL=http://headroom-gateway:8787

# Gateway behavior
GATEWAY_REQUEST_TIMEOUT_SECONDS=600
GATEWAY_MODEL_REFRESH_SECONDS=15
GATEWAY_DEFAULT_CONTEXT_LENGTH=32768
